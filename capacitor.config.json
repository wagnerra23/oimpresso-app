{
  "appId": "com.oimpresso.app",
  "appName": "oimpresso",
  "webDir": "www",
  "appendUserAgent": "oimpressoApp",
  "server": {
    "url": "https://oimpresso.com/m",
    "cleartext": false,
    "allowNavigation": [
      "oimpresso.com",
      "*.oimpresso.com"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#795BBF",
      "showSpinner": false
    },
    "App": {
      "disableBackButtonHandler": true
    }
  }
}
