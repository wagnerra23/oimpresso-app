{
  "appId": "com.oimpresso.app",
  "appName": "oimpresso",
  "webDir": "www",
  "appendUserAgent": "oimpressoApp",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#795BBF",
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
